datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


enum Role {
  ADMIN
  STAFF
}
enum ConversationMode {
  AI
  HUMAN
  CLOSED
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id String @id @default(cuid())
  phone String @unique
  name String?
  email String?
  address Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  donations Donation[]
  orders Order[]
  conversations Conversation[]
}

model AdminUser {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role Role @default(STAFF)
  createdAt DateTime @default(now())
}

model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String
  price Int
  currency String @default("INR")
  imageUrl String?
  stock Int @default(0)
  active Boolean @default(true)
  category String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
}

model Donation {
  id String @id @default(cuid())
  reference String @unique
  userId String
  amount Int
  currency String @default("INR")
  paymentStatus PaymentStatus @default(PENDING)
  razorpayOrderId String?
  razorpayPaymentId String?
  receiptUrl String?
  paidAt DateTime?
  receiptSentAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id])

  @@index([paymentStatus, createdAt])
  @@index([razorpayOrderId])
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  userId String
  status OrderStatus @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  subtotal Int
  shippingFee Int @default(0)
  total Int
  currency String @default("INR")
  address Json
  razorpayOrderId String?
  razorpayPaymentId String?
  wooOrderId String?
  shiprocketOrderId String?
  awb String?
  courier String?
  trackingUrl String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id])
  items OrderItem[]

  @@index([paymentStatus, createdAt])
  @@index([razorpayOrderId])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  quantity Int
  unitPrice Int
  order Order @relation(fields:[orderId], references:[id], onDelete: Cascade)
  product Product @relation(fields:[productId], references:[id])
}

model Conversation {
  id String @id @default(cuid())
  userId String
  mode ConversationMode @default(AI)
  // Checkout/donation state machine for the WhatsApp bot (see services/whatsapp-bot.ts)
  state Json?
  lastMessageAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id])
  messages Message[]
  supportTickets SupportTicket[]
}

model Message {
  id String @id @default(cuid())
  conversationId String
  direction String
  text String
  metadata Json?
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields:[conversationId], references:[id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model KnowledgeDocument {
  id String @id @default(cuid())
  title String
  content String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id String @id @default(cuid())
  conversationId String
  status String @default("OPEN")
  subject String?
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields:[conversationId], references:[id], onDelete: Cascade)
}

model WebhookEvent {
  id String @id @default(cuid())
  provider String
  eventId String @unique
  payload Json
  processed Boolean @default(false)
  createdAt DateTime @default(now())
}


model GalleryImage {
  id String @id @default(cuid())
  title String @default("Sangat Gallery")
  imageUrl String
  altText String?
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventPoster {
  id String @id @default(cuid())
  title String
  description String?
  imageUrl String
  eventDate String?
  venue String?
  active Boolean @default(true)
  featured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
