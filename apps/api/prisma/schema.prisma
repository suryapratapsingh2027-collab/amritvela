datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


enum Role {
  ADMIN
  STAFF
}
enum ConversationMode {
  AI
  HUMAN
  CLOSED
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  // Preferred chat language chosen from the WhatsApp language list: en | hi | hing | pa (null = not chosen yet)
  language String?
  id String @id @default(cuid())
  phone String @unique
  name String?
  email String?
  address Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  donations Donation[]
  orders Order[]
  conversations Conversation[]
  // Live Kirtan alerts: customers who have chatted with the bot receive them until they reply STOP.
  liveAlerts Boolean @default(true)
  // Private admin notes about the donor (never shown to the customer).
  notes String?
}

model AdminUser {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role Role @default(STAFF)
  // Bumped on every password change/reset so previously issued JWTs stop working.
  tokenVersion Int @default(0)
  createdAt DateTime @default(now())
  passwordResets PasswordReset[]
}

model PasswordReset {
  id String @id @default(cuid())
  adminId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  admin AdminUser @relation(fields:[adminId], references:[id], onDelete: Cascade)

  @@index([adminId])
}

model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String
  price Int
  currency String @default("INR")
  imageUrl String?
  stock Int @default(0)
  active Boolean @default(true)
  category String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
}

model Donation {
  id String @id @default(cuid())
  reference String @unique
  userId String
  amount Int
  currency String @default("INR")
  paymentStatus PaymentStatus @default(PENDING)
  razorpayOrderId String?
  razorpayPaymentId String?
  receiptUrl String?
  paidAt DateTime?
  receiptSentAt DateTime?
  receiptAttempts Int @default(0)
  // Unique, sequential per financial year, e.g. AVT/2026-27/000123. Assigned when the payment is verified.
  receiptNumber String? @unique
  campaignId String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id])
  campaign Campaign? @relation(fields:[campaignId], references:[id], onDelete: SetNull)

  @@index([paymentStatus, createdAt])
  @@index([razorpayOrderId])
  @@index([campaignId])
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  userId String
  status OrderStatus @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  subtotal Int
  shippingFee Int @default(0)
  total Int
  currency String @default("INR")
  address Json
  razorpayOrderId String?
  razorpayPaymentId String?
  wooOrderId String?
  shiprocketOrderId String?
  shiprocketShipmentId String?
  awb String?
  courier String?
  trackingUrl String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id])
  items OrderItem[]

  @@index([paymentStatus, createdAt])
  @@index([razorpayOrderId])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  quantity Int
  unitPrice Int
  order Order @relation(fields:[orderId], references:[id], onDelete: Cascade)
  product Product @relation(fields:[productId], references:[id])
}

model Conversation {
  id String @id @default(cuid())
  userId String
  mode ConversationMode @default(AI)
  // Checkout/donation state machine for the WhatsApp bot (see services/whatsapp-bot.ts)
  state Json?
  // WHATSAPP or WEB (website assistant). Admin replies to WEB chats appear in the website widget, not on WhatsApp.
  channel String @default("WHATSAPP")
  lastMessageAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id])
  messages Message[]
  supportTickets SupportTicket[]
}

model Message {
  id String @id @default(cuid())
  conversationId String
  direction String
  text String
  metadata Json?
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields:[conversationId], references:[id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model KnowledgeDocument {
  id String @id @default(cuid())
  title String
  content String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id String @id @default(cuid())
  conversationId String
  status String @default("OPEN")
  subject String?
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields:[conversationId], references:[id], onDelete: Cascade)
}

model WebhookEvent {
  id String @id @default(cuid())
  provider String
  eventId String @unique
  payload Json
  processed Boolean @default(false)
  createdAt DateTime @default(now())
}


model GalleryImage {
  id String @id @default(cuid())
  title String @default("Sangat Gallery")
  imageUrl String
  altText String?
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventPoster {
  id String @id @default(cuid())
  title String
  description String?
  imageUrl String
  eventDate String?
  venue String?
  active Boolean @default(true)
  featured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// PDF files the admin uploads; the WhatsApp bot offers them in the "Downloads" list. Bytes live in the database so
// delivery never depends on a third-party file host.
model Document {
  id String @id @default(cuid())
  title String
  description String?
  fileName String
  mimeType String @default("application/pdf")
  size Int
  data Bytes
  active Boolean @default(true)
  sortOrder Int @default(0)
  downloads Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// Additional trusts (for example Nanak Roti Trust) managed from the admin panel. The WhatsApp bot shows the
// information (in the customer's language when provided) and the UPI QR code donors can scan.
model Trust {
  id String @id @default(cuid())
  slug String @unique
  name String
  active Boolean @default(true)
  sortOrder Int @default(0)
  infoEn String @default("")
  infoHi String?
  infoHing String?
  infoPa String?
  qrImageUrl String?
  upiId String?
  contactPhone String?
  contactEmail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Small key/value store for admin-managed settings (social links, ...).
model Setting {
  key String @id
  value String
  updatedAt DateTime @updatedAt
}

// Fundraising campaigns shown on the website (progress bars) and in the WhatsApp Donate list.
model Campaign {
  id String @id @default(cuid())
  slug String @unique
  title String
  status String @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  descriptionEn String @default("")
  descriptionHi String?
  descriptionHing String?
  descriptionPa String?
  imageUrl String?
  targetAmount Int
  startsAt DateTime?
  endsAt DateTime?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  donations Donation[]
}

// Atomic sequence numbers (receipt numbers per financial year).
model Counter {
  key String @id
  value Int @default(0)
}

// When the Trust's YouTube Live kirtan normally starts. The admin can add, move or pause slots at any time.
model LiveSchedule {
  id String @id @default(cuid())
  label String
  time String // HH:mm, India time
  days String @default("0,1,2,3,4,5,6") // comma separated, 0 = Sunday
  onceDate String? // YYYY-MM-DD: a one-off slot for a special day
  active Boolean @default(true)
  lastFiredKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One "live kirtan" alert run (manual, scheduled or test) with delivery counters.
model Broadcast {
  id String @id @default(cuid())
  kind String @default("LIVE_KIRTAN")
  trigger String // MANUAL | SCHEDULE | TEST
  title String
  url String
  scheduleId String?
  status String @default("RUNNING") // RUNNING | DONE | FAILED
  total Int @default(0)
  sent Int @default(0)
  failed Int @default(0)
  skipped Int @default(0)
  error String?
  createdAt DateTime @default(now())
  finishedAt DateTime?

  @@index([createdAt])
}
